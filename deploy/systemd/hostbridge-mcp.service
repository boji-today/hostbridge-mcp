[Unit]
Description=HostBridge MCP Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hostbridge
Group=hostbridge

WorkingDirectory=/opt/hostbridge-mcp/app
EnvironmentFile=/etc/hostbridge-mcp.env

ExecStart=/opt/hostbridge-mcp/.venv/bin/uvicorn hostbridge_mcp.server:app --host 127.0.0.1 --port 8765 --workers 1

Restart=on-failure
RestartSec=5

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/srv/agent-workspace

[Install]
WantedBy=multi-user.target
