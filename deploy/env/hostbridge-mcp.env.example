# HostBridge MCP - Environment Configuration
# HostBridge MCP - 环境配置示例
#
# Copy this file to /etc/hostbridge-mcp.env
# 复制到 /etc/hostbridge-mcp.env 后修改实际参数
#
# Never commit real tokens or secrets to Git.
# 不要将真实 Token 或敏感配置提交到 Git。

# ==========================================================
# Authentication / 身份认证
# ==========================================================

# Required: Bearer token, minimum 32 characters.
# 必填：Bearer Token，至少 32 个字符。
# Generate with: openssl rand -hex 32
# 生成命令：openssl rand -hex 32
MCP_ACCESS_TOKEN=REPLACE_WITH_A_RANDOM_SECRET

# ==========================================================
# File Access / 文件访问
# ==========================================================

# Root directory for MCP file tools.
# MCP 文件读写工具的根目录。
#
# The directory must exist before startup.
# 服务启动前该目录必须存在。
MCP_FILE_ROOT=/srv/agent-workspace

# Maximum file read/write size in bytes (default: 1 MiB).
# 单个文件最大读写字节数，默认 1 MiB。
MCP_MAX_FILE_BYTES=1048576

# ==========================================================
# Command Execution / 命令执行
# ==========================================================

# Enable execute_command tool.
# 是否允许通过 MCP 执行 Shell 命令。
#
# WARNING: Arbitrary shell execution with service-user privileges.
# 警告：启用后可执行任意 Shell 命令，权限取决于服务运行账号。
#
# false = disabled / 禁用
# true  = enabled  / 启用
MCP_ENABLE_COMMANDS=false

# Maximum command execution timeout in seconds.
# 单条命令最大执行时间（秒）。
MCP_MAX_TIMEOUT=120

# Maximum returned stdout/stderr size in bytes.
# stdout 和 stderr 各自允许返回的最大字节数。
MCP_MAX_OUTPUT_BYTES=65536
